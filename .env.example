# Wzór pliku .env dla Prawdowida. Skopiuj go do .env i wpisz własne wartości:
#   cp .env.example .env
# Plik .env nie trafia do repozytorium ani do obrazu Dockera (.gitignore, .dockerignore).

# --- Model językowy (wymagane) ---
# Dostawca: mistral | gemini | anthropic | openai
AI_PROVIDER=mistral
# Klucz dostawcy (np. https://console.mistral.ai albo https://aistudio.google.com/apikey).
# Trafia tylko do lokalnego serwera OpenCode, nie do logu ani przeglądarki.
AI_API_KEY=
# Model, np. mistral-large-latest, mistral-medium-latest, gemini-3.5-flash
AI_MODEL=mistral-large-latest

# --- Google Fact Check Tools API (opcjonalne) ---
# Oceny organizacji fact-checkingowych (ClaimReview). Klucz: Google Cloud, API "Fact Check Tools".
# Uwaga: integracja jest w toku - zobacz docs/ARCHITEKTURA.md, sekcja "Ograniczenia".
GOOGLE_FACT_CHECK_API_KEY=

# --- Bot Discorda (tylko gdy uruchamiasz bota) ---
# Token z https://discord.com/developers/applications (zakładka Bot -> Reset Token).
DISCORD_TOKEN=
# Dowolny długi losowy ciąg, np.: python3 -c "import secrets; print(secrets.token_hex(32))"
BOT_USER_SALT=
# ID serwera testowego - komendy /sprawdz, /usun, /pomoc pojawią się od razu (opcjonalne).
DISCORD_GUILD_ID=

# --- Opcjonalne ustawienia (wartości domyślne) ---
# AGENT_TIMEOUT=300                 # ile sekund czekamy na agenta
# PRAWDOWID_API_TIMEOUT=360         # ile sekund bot czeka na backend (więcej niż AGENT_TIMEOUT)
# LOG_RETENTION_DAYS=7              # po ilu dniach wpisy logu sprawdzeń są usuwane
# ADMIN_TOKEN=                      # dostęp do /api/v1/log spoza tego komputera (Bearer)
# MAX_TEXT_CHARS=5000               # maks. długość sprawdzanego tekstu
# RATE_LIMIT_PER_MINUTE=5           # zapytania na osobę na minutę
# RATE_LIMIT_GLOBAL_PER_MINUTE=30   # zapytania łącznie na minutę
