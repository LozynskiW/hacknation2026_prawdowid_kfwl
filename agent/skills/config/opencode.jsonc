{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "https://*.gov.pl/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://policja.pl/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://*.imgw.pl/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://moje.cert.pl/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://portalpasazera.pl/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://kgsok.pl/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://www.prezydent.pl/*", "effect": "allow" }
  ]
}